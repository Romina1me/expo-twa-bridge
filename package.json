{
  "name": "expo-twa-bridge",
  "version": "0.1.1",
  "description": "A reusable Expo native module for Android Trusted Web Activities",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "android/build.gradle",
    "android/src/main",
    "app.plugin.js",
    "build",
    "expo-module.config.json",
    "plugin/build",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "build:once": "node internal/module_scripts/build.js --once && node internal/module_scripts/build.js plugin --once",
    "sync:example": "npm run build:once && node internal/module_scripts/sync-example.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "test": "node internal/module_scripts/test.js",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-twa-bridge",
    "ExpoTwaBridge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Romina1me/expo-twa-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Romina1me/expo-twa-bridge/issues"
  },
  "author": "Romina arefkya <arefkyar@gmail.com> (https://github.com/Romina1me)",
  "license": "MIT",
  "homepage": "https://github.com/Romina1me/expo-twa-bridge#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.22",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^16.1.2",
    "expo": "^58.0.21",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.13",
    "prettier": "^3.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  }
}
